<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls">
    <Styles.Resources>

        <ResourceDictionary>

			<!-- v12 no need for v12. Also, expricitly specified in App.axaml.cs. 
			Temp workaround for https://github.com/AvaloniaUI/Avalonia/issues/19592 
			<FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter</FontFamily>
			 -->
			<CornerRadius x:Key="NavigationViewContentGridCornerRadius">0,0,0,0</CornerRadius>
			<Thickness x:Key="NavigationViewContentGridBorderThickness">1,0,0,0</Thickness>
			<Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0,0,0,0</Thickness>
			<Thickness x:Key="TopNavigationViewContentGridBorderThickness">0,0,0,0</Thickness>

			<x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">15</x:Double>

			<!-- fix non-align items -->
			<Thickness x:Key="NavigationViewItemContentPresenterMargin">-4,0,0,0</Thickness>
			<Thickness x:Key="NavigationViewPaneContentGridMargin">0,4,0,3</Thickness>

			<!-- fix 3>4, 16>18 This is because we added transparent border 1px to SelectionIndicator in order to delete strange artifacts after erase animation.  -->
			<x:Double x:Key="NavigationViewSelectionIndicatorWidth">4</x:Double>
			<x:Double x:Key="NavigationViewSelectionIndicatorHeight">18</x:Double>

			<StaticResource x:Key="CardStrokeBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
			
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://PlaylistEditorX/Styles/NavigationViewStyles.axaml" />
				<ResourceInclude Source="avares://PlaylistEditorX/Styles/NavigationViewItemStyles.axaml" />
				<ResourceInclude Source="avares://PlaylistEditorX/Styles/NavigationViewItemPresenterStyles.axaml" />
				<ResourceInclude Source="avares://PlaylistEditorX/Styles/WindowDecorations.axaml" />
			</ResourceDictionary.MergedDictionaries>

			<!-- Inner Styling: The Custom Segmented TabItem Theme -->
			<ControlTheme x:Key="SegmentedTabItemTheme" TargetType="TabItem">
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="Foreground" Value="#A6A6A6"/>
				<Setter Property="Padding" Value="16, 6"/>
				<Setter Property="FontSize" Value="13"/>
				<Setter Property="CornerRadius" Value="4"/>
				<Setter Property="HorizontalAlignment" Value="Stretch"/>
				<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
				<Setter Property="VerticalContentAlignment" Value="Center"/>
				<Setter Property="MinHeight" Value="32"/>
				<Setter Property="Template">
					<ControlTemplate>
						<Border Name="PART_LayoutRoot"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{TemplateBinding CornerRadius}"
								Padding="{TemplateBinding Padding}"
								HorizontalAlignment="Stretch">
							<ContentPresenter Name="PART_ContentPresenter"
											  Content="{TemplateBinding Header}"
											  ContentTemplate="{TemplateBinding HeaderTemplate}"
											  HorizontalAlignment="Center"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
					</ControlTemplate>
				</Setter>

				<!-- Hover State (Crosses exactly one /template/ boundary) -->
				<Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
					<Setter Property="Background" Value="#15FFFFFF"/>
				</Style>
				<Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Foreground" Value="#FFFFFF"/>
				</Style>

				<!-- Selected State (Crosses exactly one /template/ boundary) -->
				<Style Selector="^:selected /template/ Border#PART_LayoutRoot">
					<Setter Property="Background" Value="#2D2D2D"/>
					<Setter Property="BorderBrush" Value="#3F3F3F"/>
					<Setter Property="BorderThickness" Value="1"/>
					<Setter Property="BoxShadow" Value="0 1 3 0 #40000000"/> 
				</Style>
				<Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Foreground" Value="#FFFFFF"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
				</Style>
			</ControlTheme>

			<!-- Outer Layout: The Main Segmented TabControl Theme -->
			<ControlTheme x:Key="MyCustomSegmentedTheme" TargetType="TabControl">
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="Padding" Value="0, 10, 0, 0"/>
        
				<!-- Inject the inner TabItem theme safely without breaking template boundaries -->
				<Setter Property="ItemContainerTheme" Value="{StaticResource SegmentedTabItemTheme}"/>

				<Setter Property="HorizontalAlignment" Value="Stretch"/>
        
				<Setter Property="ItemsPanel">
					<ItemsPanelTemplate>
						<UniformGrid Rows="1" HorizontalAlignment="Stretch"/> 
					</ItemsPanelTemplate>
				</Setter>
				<Setter Property="Template">
					<ControlTemplate>
						<Grid RowDefinitions="Auto, *">
							<!-- Outer track container -->
							<Border Grid.Row="0"
									Background="#1E1E1E" 
									BorderBrush="#2B2B2B"
									BorderThickness="1"
									CornerRadius="6"
									Padding="2"
									HorizontalAlignment="Stretch">
								<ItemsPresenter Name="PART_ItemsPresenter" 
												ItemsPanel="{TemplateBinding ItemsPanel}" />
							</Border>
							<!-- Content Viewport -->
							<ContentPresenter Grid.Row="1"
											  Name="PART_SelectedContentHost"
											  Padding="{TemplateBinding Padding}"
											  Content="{TemplateBinding SelectedContent}"
											  ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
						</Grid>
					</ControlTemplate>
				</Setter>
			</ControlTheme>

        </ResourceDictionary>
    </Styles.Resources>
</Styles>
