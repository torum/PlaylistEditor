<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

	  <IsAotCompatible>true</IsAotCompatible>

	  <ApplicationIcon>Assets\PlaylistEditorX.ico</ApplicationIcon>
	  
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<!-- Code quality -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
	</PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\PlaylistEditorX.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Egolds.Xaml.Behaviors.Interactions.Animated" Version="11.4.0" />
	  <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\AboutDialog.axaml.cs">
      <DependentUpon>AboutDialog.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\EditDialog.axaml.cs">
      <DependentUpon>EditDialog.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\FindAndReplaceDialog.axaml.cs">
      <DependentUpon>FindAndReplaceDialog.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
